#!/bin/sh
# Cancel rollback only after an external client confirms this boot's management.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
BOOT_ID=$(cat /proc/sys/kernel/random/boot_id) || exit 1
MARKER=/tmp/sr7420-usb-management-confirmed
n=0
while [ "$n" -lt 120 ]; do
 sleep 1; n=$((n+1))
 [ "$(cat "$MARKER" 2>/dev/null)" = "$BOOT_ID" ] || continue
 /usr/sbin/sr7420-usb-confirm --check || continue
 disk=$(cat /etc/sr7420-usb-disk 2>/dev/null) || continue
 case "$disk" in sd[a-z]) :;; *) continue;; esac
 mkdir -p /boot
 mount -t ext4 "/dev/${disk}1" /boot || continue
 printf '%s\n' "$BOOT_ID" > /boot/boot-ready
 rm -f /boot/boot-pending
 sync; umount /boot
 printf 'READY externally confirmed after %s seconds boot=%s\n' "$n" "$BOOT_ID" >>/boot-state/stages.log
 exit 0
done
printf 'FAILED: 120-second external management confirmation deadline boot=%s\n' "$BOOT_ID" >>/boot-state/stages.log
sync
reboot -f
sleep 5
echo b >/proc/sysrq-trigger
