#!/bin/sh
# Pending state is set by the stock launcher and cleared only after LAN + services.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
n=0
while [ "$n" -lt 180 ]; do
 sleep 1; n=$((n+1))
 [ -S /var/run/ubus/ubus.sock ] || continue
 status=$(ubus call network.interface.lan status 2>/dev/null) || continue
 [ "$(printf '%s' "$status" | jsonfilter -e '@.up')" = true ] || continue
 [ -n "$(printf '%s' "$status" | jsonfilter -e '@["ipv4-address"][0].address')" ] || continue
 pidof uhttpd >/dev/null && pidof dropbear >/dev/null || continue
 # Readiness means local management services are up, not an external reachability test.
 disk=$(cat /etc/sr7420-usb-disk 2>/dev/null) || continue
 case "$disk" in sd[a-z]) :;; *) continue;; esac
 mkdir -p /boot
 mount -t ext4 "/dev/${disk}1" /boot || continue
 rm -f /boot/boot-pending
 date -u > /boot/boot-ready
 sync; umount /boot
 printf 'READY after %s seconds\n' "$n" >>/boot-state/stages.log
 exit 0
done
printf 'FAILED: management readiness deadline\n' >>/boot-state/stages.log
sync
# A normal reboot returns through the original bootloader and stock system.
reboot -f
sleep 5
echo b >/proc/sysrq-trigger
