+#ifdef CONFIG_SR7420_WARM_HANDOVER
+.pushsection ".idmap.text", "a"
+/* SR7420 RAM diagnostic only, called with MMU off after stock kexec.
+ * No clock/reset changes. Old CPUs are already stopped. x0-x3 untouched.
+ * Stop XMAC ingress, drain for 125 ms, stop egress, mask IDM IRQs;
+ * observe 19 completion words over another 125 ms before starting Linux.
+ * Retained evidence stays in the reserved final 256 bytes of RAM log.
+ */
+SYM_CODE_START_LOCAL(sr7420_warm_quiesce)
+ cbnz x19, 9f
+ mov_q x9, 0xb52fff00
+ mov_q x10, 0x31514d5241575253 // "SRWARMQ1"
+ str x10, [x9]
+ str wzr, [x9, #8]
+ mov_q x10, 0x10e10048
+ ldr w11, [x10]
+ str w11, [x9, #12]
+ /* NPPT PCLK and XMAC working clock must already be live. */
+ tbz w11, #2, 9f
+ tbz w11, #12, 9f
+ mov_q x10, 0x19140000
+ mov_q x11, 0x19180000
+ ldr w12, [x10, #0x10]
+ ldr w13, [x11, #0x10]
+ stp w12, w13, [x9, #16]
+ bic w12, w12, #1
+ bic w13, w13, #1
+ str w12, [x10, #0x10]
+ str w13, [x11, #0x10]
+ dsb sy
+ mrs x12, cntpct_el0
+ mrs x13, cntfrq_el0
+ lsr x13, x13, #3
+ add x12, x12, x13
+1: mrs x14, cntpct_el0
+ cmp x14, x12
+ b.lo 1b
+ ldr w12, [x10]
+ ldr w13, [x11]
+ stp w12, w13, [x9, #24]
+ bic w12, w12, #1
+ bic w13, w13, #1
+ str w12, [x10]
+ str w13, [x11]
+ mov_q x10, 0x19280040
+ ldr w12, [x10]
+ str w12, [x9, #32]
+ mov w12, #0xffff
+ movk w12, #0x7ff, lsl #16
+ str w12, [x10]
+ dsb sy
+ /* Contiguous IDM +0xa8..0xf0: TX done and RX counters, 19 words. */
+ mov_q x10, 0x192800a8
+ add x11, x9, #48
+ mov w12, #19
+2: ldr w13, [x10], #4
+ str w13, [x11], #4
+ subs w12, w12, #1
+ b.ne 2b
+ mrs x12, cntpct_el0
+ mrs x13, cntfrq_el0
+ lsr x13, x13, #3
+ add x12, x12, x13
+3: mrs x14, cntpct_el0
+ cmp x14, x12
+ b.lo 3b
+ mov_q x10, 0x192800a8
+ add x11, x9, #48
+ add x12, x9, #128
+ mov w13, #19
+ mov w16, #1
+4: ldr w14, [x10], #4
+ ldr w15, [x11], #4
+ str w14, [x12], #4
+ cmp w14, w15
+ csel w16, w16, wzr, eq
+ subs w13, w13, #1
+ b.ne 4b
+ str w16, [x9, #8]
+ dsb sy
+9: ret
+SYM_CODE_END(sr7420_warm_quiesce)
+
+.popsection
+#endif
--- a/drivers/tty/serial/earlycon.c
