+#ifdef CONFIG_SR7420_WARM_HANDOVER
+/* Diagnostic-only RAM early console. Exactly one validated DRAM page. */
+#define SR7420_RAMLOG_BASE 0xb52f0000UL
+#define SR7420_RAMLOG_HEADER 64U
+#define SR7420_RAMLOG_CAPACITY (4096U - SR7420_RAMLOG_HEADER)
+static void sr7420_ramlog_write(struct console *con, const char *s,
+                               unsigned int count)
+{
+        struct earlycon_device *dev = con->data;
+        void __iomem *base = dev->port.membase;
+        u32 pos = readl(base + 16);
+        u32 total = readl(base + 20);
+        unsigned int i;
+
+        if (pos >= SR7420_RAMLOG_CAPACITY)
+                return;
+        for (i = 0; i < count; i++) {
+                writeb(s[i], base + SR7420_RAMLOG_HEADER + pos);
+                if (++pos == SR7420_RAMLOG_CAPACITY)
+                        pos = 0;
+        }
+        wmb();
+        writel(pos, base + 16);
+        writel(total + count, base + 20);
+        wmb();
+}
+
+static int __init sr7420_ramlog_setup(struct earlycon_device *dev,
+                                     const char *options)
+{
+        static const char signature[16] = "SR7420-RAMLOG-V1";
+        static const char attempt[] = "wifi-20261116-05";
+        void __iomem *base = dev->port.membase;
+        unsigned int i;
+
+        if (dev->port.mapbase != SR7420_RAMLOG_BASE || !base)
+                return -EINVAL;
+        for (i = 0; i < 4096; i++)
+                writeb(0, base + i);
+        for (i = 0; i < sizeof(signature); i++)
+                writeb(signature[i], base + i);
+        writel(SR7420_RAMLOG_HEADER, base + 24);
+        writel(SR7420_RAMLOG_CAPACITY, base + 28);
+        for (i = 0; i < sizeof(attempt); i++)
+                writeb(attempt[i], base + 32 + i);
+        wmb();
+        dev->con->write = sr7420_ramlog_write;
+        return 0;
+}
+EARLYCON_DECLARE(sr7420ram, sr7420_ramlog_setup);
+
+#endif
