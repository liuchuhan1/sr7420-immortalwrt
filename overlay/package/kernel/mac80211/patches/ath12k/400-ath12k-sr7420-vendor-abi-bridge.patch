+static int sr7420_diag_wsi_nodes(struct ath12k_hw_group *ag,
+                                struct ath12k_base *ab)
+{
+        struct device_node *two, *five;
+        int ret = -ENODEV;
+
+        two = of_find_node_by_path("/soc/pcie@15202000/pcie1_rp@0/radio@0");
+        five = of_find_node_by_path("/soc/pcie@15200000/pcie0_rp@0/radio@0");
+        if (!two || !five ||
+            (ab->dev->of_node != two && ab->dev->of_node != five))
+                goto out;
+
+        ag->wsi_node[0] = two;
+        ag->wsi_node[1] = five;
+        ag->num_devices = 2;
+        ath12k_info(ab, "SR7420_WSI topology=2g:0,5g:1 devices=2\n");
+        ret = 0;
+out:
+        of_node_put(two);
+        of_node_put(five);
+        return ret;
+}
