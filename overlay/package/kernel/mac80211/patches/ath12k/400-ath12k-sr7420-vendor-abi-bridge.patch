+static int ath12k_sr7420_qmi_ini_send(struct ath12k_base *ab)
+{
+ const struct firmware *fw;
+ struct sr7420_ini_req *req;
+ struct qmi_wlanfw_host_cap_resp_msg_v01 resp = {};
+ struct qmi_txn txn;
+ size_t off = 0;
+ int ret;
+
+ if (!sr7420_ini_download)
+  return 0;
+ BUILD_BUG_ON(offsetof(struct sr7420_ini_req, data) != 32);
+ BUILD_BUG_ON(offsetof(struct sr7420_ini_req, end_valid) != 6176);
+ fw = ath12k_core_firmware_request(ab, "fw_ini_cfg.bin");
+ if (IS_ERR(fw))
+  return PTR_ERR(fw);
+ if (!fw->size || fw->size > 256 * 1024) {
+  ret = -EINVAL;
+  goto release;
+ }
+ req = kzalloc(sizeof(*req), GFP_KERNEL);
+ if (!req) {
+  ret = -ENOMEM;
+  goto release;
+ }
+ req->file_type_valid = 1;
+ req->file_type = 0;
+ req->total_size_valid = 1;
+ req->seg_id_valid = 1;
+ req->data_valid = 1;
+ req->end_valid = 1;
+ do {
+  req->total_size = fw->size - off;
+  req->data_len = min_t(size_t, fw->size - off, sizeof(req->data));
+  req->end = (off + req->data_len == fw->size);
+  memcpy(req->data, fw->data + off, req->data_len);
+  memset(&resp, 0, sizeof(resp));
+  ret = qmi_txn_init(&ab->qmi.handle, &txn,
+                    qmi_wlanfw_host_cap_resp_msg_v01_ei, &resp);
+  if (ret < 0)
+   break;
+  ret = qmi_send_request(&ab->qmi.handle, NULL, &txn, 0x56, 6174,
+                         sr7420_ini_req_ei, req);
+  if (ret < 0) {
+   qmi_txn_cancel(&txn);
+   break;
+  }
+  ret = qmi_txn_wait(&txn, msecs_to_jiffies(ATH12K_QMI_WLANFW_TIMEOUT_MS));
+  if (ret < 0)
+   break;
+  if (resp.resp.result != QMI_RESULT_SUCCESS_V01) {
+   ath12k_warn(ab, "SR7420_INI rejected result=%u error=%u\n",
+               resp.resp.result, resp.resp.error);
+   ret = -EINVAL;
+   break;
+  }
+  off += req->data_len;
+  req->seg_id++;
+ } while (off < fw->size);
+ ath12k_info(ab, "SR7420_INI downloaded=%zu size=%zu segments=%u ret=%d\n",
+             off, fw->size, req->seg_id, ret);
+ kfree(req);
+release:
+ release_firmware(fw);
+ return ret;
+}
