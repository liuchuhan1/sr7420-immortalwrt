+static void sr7420_stock32_trace(struct ath12k_wmi_pdev *wmi, struct sk_buff *skb, u32 id)
+{
+ char name[32];
+ ath12k_info(wmi->wmi_ab->ab, "SR7420_STOCK32_TX cmd=0x%x bytes=%u\n", id, skb->len);
+ if (sr7420_diag_payload && (id == 1 || id == 0x5001 || id == 0x5003 ||
+     id == 0x48002 || id == 0x48003 || id == 0x4003 || id == 0x5008 || id == 0x6001)) {
+  snprintf(name, sizeof(name), "stock32-%06x", id);
+  sr7420_diag_hex(wmi->wmi_ab->ab, name, skb->data, skb->len);
+ }
+}
+
+static int sr7420_stock32_blob_send(struct ath12k_wmi_pdev *wmi, u32 id,
+                                  const u8 *data, size_t len, int vdev)
+{
+ struct sk_buff *skb = ath12k_wmi_alloc_skb(wmi->wmi_ab, len);
+ int ret;
+ if (!skb) return -ENOMEM;
+ memcpy(skb->data, data, len);
+ if (vdev >= 0) put_unaligned_le32(vdev, skb->data + 4);
+ sr7420_stock32_trace(wmi, skb, id);
+ ret = sr7420_stock32_send_base(wmi, skb, id);
+ if (ret) dev_kfree_skb(skb);
+ return ret;
+}
+
+static int sr7420_stock32_replace(struct sk_buff *skb, const u8 *data, size_t len)
+{
+ int extra = (int)len - (int)skb->len;
+ int ret;
+ if (extra > 0) {
+  if (skb_tailroom(skb) < extra) {
+   ret = pskb_expand_head(skb, 0, extra - skb_tailroom(skb), GFP_KERNEL);
+   if (ret) return ret;
+  }
+  skb_put(skb, extra);
+ } else if (extra < 0) {
+  skb_trim(skb, len);
+ }
+ memcpy(skb->data, data, len);
+ return 0;
+}
+
+static int sr7420_stock32_pdev(struct ath12k_wmi_pdev *wmi, int radio, int domain)
+{
+ const struct sr7420_stock32_blob *seq;
+ size_t count, i;
+ int ret;
+ if (test_and_set_bit(0, &sr7420_stock32_state[domain].flags)) return 0;
+ if (radio) { seq = sr7420_stock32_p1; count = ARRAY_SIZE(sr7420_stock32_p1); }
+ else { seq = sr7420_stock32_p0; count = ARRAY_SIZE(sr7420_stock32_p0); }
+ for (i = 0; i < count; i++) {
+  ret = sr7420_stock32_blob_send(wmi, seq[i].cmd, seq[i].data, seq[i].len, -1);
+  if (ret) return ret;
+ }
+ return 0;
+}
+
+static int sr7420_stock32_vdev(struct ath12k_wmi_pdev *wmi, int radio, int domain, u32 vdev)
+{
+ const struct sr7420_stock32_blob *seq;
+ size_t count, i;
+ int ret;
+ if (vdev >= 9) return -EINVAL;
+ if (test_and_set_bit(vdev, &sr7420_stock32_state[domain].vdev_configured)) return 0;
+ ret = sr7420_stock32_blob_send(wmi, 0x3a004, sr7420_stock32_country,
+                              sizeof(sr7420_stock32_country), -1);
+ if (ret) return ret;
+ if (radio) { seq = sr7420_stock32_v1; count = ARRAY_SIZE(sr7420_stock32_v1); }
+ else { seq = sr7420_stock32_v0; count = ARRAY_SIZE(sr7420_stock32_v0); }
+ for (i = 0; i < count; i++) {
+  ret = sr7420_stock32_blob_send(wmi, seq[i].cmd, seq[i].data, seq[i].len, vdev);
+  if (ret) return ret;
+ }
+ return 0;
+}
