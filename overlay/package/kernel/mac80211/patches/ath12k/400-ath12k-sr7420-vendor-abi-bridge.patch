+/* SR7420 firmware wire ABI adapter. No DMA addresses are replayed.
+ * Input is the complete ath12k-generated WMI payload, before the command header.
+ * Only verified layout conversions are accepted; real MLO remains unsupported.
+ */
+static int sr7420_fw37_tlv(const u8 *p, size_t len, size_t off,
+                          u32 tag, size_t *size)
+{
+ u32 h;
+ if (off > len || len - off < 4)
+  return -EINVAL;
+ h = get_unaligned_le32(p + off);
+ *size = (h & 0xffff) + 4;
+ if ((h >> 16) != tag || *size > len - off || (*size & 3))
+  return -EINVAL;
+ return 0;
+}
+
+static int sr7420_fw37_wire(u32 id, int radio, const u8 *p, size_t len,
+                           u8 *out, size_t cap, size_t *used)
+{
+ size_t fixed, n, off, a, j;
+ u32 value, band;
+ const u8 *stock;
+ struct ath12k_wmi_resource_config_params *cfg;
+
+ *used = 0;
+ if (radio < 0 || radio > 1 || len < 4 || (len & 3))
+  return -EINVAL;
+ switch (id) {
+ case WMI_INIT_CMDID:
+  if (cap < sizeof(sr7420_stock32_init) ||
+      sr7420_fw37_tlv(p, len, 0, WMI_TAG_INIT_CMD, &fixed) || fixed != 32 ||
+      get_unaligned_le32(p + 28) != 0 ||
+      sr7420_fw37_tlv(p, len, fixed, WMI_TAG_RESOURCE_CONFIG, &n) ||
+      (n != 292 && n != 336) ||
+      sr7420_fw37_tlv(p, len, fixed + n, WMI_TAG_ARRAY_STRUCT, &a) || a != 4)
+   return -EINVAL;
+  if (get_unaligned_le32(p + fixed + 4) != 9 ||
+      get_unaligned_le32(p + fixed + 8) != 137)
+   return -EOPNOTSUPP;
+  /* Optional HW-mode setup belongs to the upstream encoder. The captured
+   * firmware already uses the paired radio mode. Validate before omitting. */
+  off = fixed + n + a;
+  if (off < len) {
+   if (sr7420_fw37_tlv(p, len, off, WMI_TAG_PDEV_SET_HW_MODE_CMD, &a) ||
+       a != 16 || off + a + 4 > len)
+    return -EINVAL;
+   value = get_unaligned_le32(p + off + 12);
+   off += a;
+   if (sr7420_fw37_tlv(p, len, off, WMI_TAG_ARRAY_STRUCT, &a) ||
+       value > 2 || a != 4 + value * 16 || off + a != len)
+    return -EOPNOTSUPP;
+   for (j = 0; j < value; j++) {
+    size_t inner;
+    if (sr7420_fw37_tlv(p, len, off + 4 + j * 16,
+                        WMI_TAG_PDEV_BAND_TO_MAC, &inner) || inner != 16)
+     return -EINVAL;
+   }
+  }
+  memcpy(out, sr7420_stock32_init, sizeof(sr7420_stock32_init));
+  memcpy(out + fixed, p + fixed, 292);
+  cfg = (void *)(out + fixed);
+  cfg->tlv_header = ath12k_wmi_tlv_cmd_hdr(WMI_TAG_RESOURCE_CONFIG, 336);
+  cfg->num_tids = cpu_to_le32(1140);
+  cfg->rx_decap_mode = cpu_to_le32(ATH12K_HW_TXRX_ETHERNET);
+  cfg->max_frag_entries = cpu_to_le32(6);
+  cfg->beacon_tx_offload_max_vdev = cfg->num_vdevs;
+  cfg->flag1 = cpu_to_le32(sr7420_survey64 ?
+                         WMI_RSRC_CFG_FLAG1_BSS_CHANNEL_INFO_64 : 0);
+  cfg->use_pdev_id = cpu_to_le32(1);
+  cfg->max_bssid_indicator = cpu_to_le32(5);
+  cfg->flags2 = le32_encode_bits(ATH12K_PEER_METADATA_V1B,
+                     WMI_RSRC_CFG_FLAGS2_RX_PEER_METADATA_VERSION);
+  cfg->host_service_flags = cpu_to_le32(0x3452);
+  cfg->max_rnr_neighbours = cpu_to_le32(16);
+  cfg->ema_max_vap_cnt = 0;
+  cfg->ema_max_profile_period = 0;
+  *used = sizeof(sr7420_stock32_init);
+  return 0;
+ case WMI_VDEV_CREATE_CMDID:
+  if (cap < 88 || sr7420_fw37_tlv(p, len, 0, WMI_TAG_VDEV_CREATE_CMD, &fixed) ||
+      fixed != 48 || get_unaligned_le32(p + 4) >= 9 ||
+      get_unaligned_le32(p + 8) != WMI_VDEV_TYPE_AP ||
+      get_unaligned_le32(p + 24) != 2 ||
+      sr7420_fw37_tlv(p, len, fixed, WMI_TAG_ARRAY_STRUCT, &a) || a != 36)
+   return -EOPNOTSUPP;
+  off = fixed + a;
+  if (off < len && (sr7420_fw37_tlv(p, len, off, WMI_TAG_ARRAY_STRUCT, &n) ||
+                    n != 4 || off + n != len))
+   return -EOPNOTSUPP; /* Do not discard a real MLD address. */
+  stock = radio ? sr7420_stock32_create1 : sr7420_stock32_create0;
+  memcpy(out, stock, 88);
+  memcpy(out, p, 48); /* vdev/type/MAC/pdev/flags/stats remain dynamic. */
+  value = 0;
+  for (j = 0; j < 2; j++) {
+   off = 52 + j * 16;
+   if (sr7420_fw37_tlv(p, len, off, WMI_TAG_VDEV_TXRX_STREAMS, &n) || n != 16)
+    return -EINVAL;
+   band = get_unaligned_le32(p + off + 4);
+   if (band > 1 || (value & (1U << band)))
+    return -EINVAL;
+   value |= 1U << band;
+   memcpy(out + 52 + band * 16, p + off, 16);
+   /* Vendor interpretation is not fully established; use its known default.
+    * START preferred TX/RX stream counts remain sourced from ath12k. */
+   put_unaligned_le32(0xf, out + 52 + band * 16 + 8);
+   put_unaligned_le32(0xf, out + 52 + band * 16 + 12);
+  }
+  *used = 88;
+  return 0;
+ case WMI_VDEV_START_REQUEST_CMDID:
+ case WMI_VDEV_RESTART_REQUEST_CMDID:
+  if (cap < 180 ||
+      sr7420_fw37_tlv(p, len, 0, WMI_TAG_VDEV_START_REQUEST_CMD, &fixed) ||
+      (fixed != 116 && fixed != 132) ||
+      get_unaligned_le32(p + 4) >= 9 || get_unaligned_le32(p + 24) > 32 ||
+      get_unaligned_le32(p + 68) != 0 ||
+      sr7420_fw37_tlv(p, len, fixed, WMI_TAG_CHANNEL, &n) || n != 28 ||
+      sr7420_fw37_tlv(p, len, fixed + n, WMI_TAG_ARRAY_STRUCT, &a) || a != 4)
+   return -EINVAL;
+  off = fixed + n + a;
+  if (off < len) {
+   if (sr7420_fw37_tlv(p, len, off, WMI_TAG_ARRAY_STRUCT, &a))
+    return -EINVAL;
+   if (a == 12) {
+    if (sr7420_fw37_tlv(p, len, off + 4, WMI_TAG_MLO_VDEV_START_PARAMS, &n) ||
+        n != 8 || get_unaligned_le32(p + off + 8))
+     return -EOPNOTSUPP;
+   } else if (a != 4) {
+    return -EOPNOTSUPP;
+   }
+   off += a;
+   if (sr7420_fw37_tlv(p, len, off, WMI_TAG_ARRAY_STRUCT, &a) ||
+       a != 4 || off + a != len)
+    return -EOPNOTSUPP;
+  }
+  value = get_unaligned_le32(p + fixed + 4);
+  if ((!radio && (value < 2400 || value >= 2500)) ||
+      (radio && (value < 4900 || value >= 5925)))
+   return -EOPNOTSUPP;
+  stock = radio ? sr7420_stock32_start1 : sr7420_stock32_start0;
+  memcpy(out, stock, 180);
+  memcpy(out, p, fixed);
+  put_unaligned_le32((WMI_TAG_VDEV_START_REQUEST_CMD << 16) | 128, out);
+  memcpy(out + 132, p + fixed, 28);
+  if (!get_unaligned_le32(p + 60)) {
+   put_unaligned_le32(radio ? 0x10000003 : 0x10000103, out + 60);
+   put_unaligned_le32(get_unaligned_le32(p + 20) | (1U << 2), out + 20);
+  }
+  *used = 180;
+  return 0;
+ case WMI_MLO_SETUP_CMDID:
+  if (sr7420_fw37_tlv(p, len, 0, WMI_TAG_MLO_SETUP_CMD, &fixed) ||
+      (fixed != 12 && fixed != 16) ||
+      sr7420_fw37_tlv(p, len, fixed, WMI_TAG_ARRAY_UINT32, &a) ||
+      a > 8 || fixed + a != len || cap < 16 + a)
+   return -EINVAL;
+  if (fixed == 16 && get_unaligned_le32(p + 12) != 137)
+   return -EOPNOTSUPP;
+  memcpy(out, p, 12);
+  put_unaligned_le32((WMI_TAG_MLO_SETUP_CMD << 16) | 12, out);
+  put_unaligned_le32(137, out + 12);
+  memcpy(out + 16, p + fixed, a);
+  *used = 16 + a;
+  return 0;
+ case WMI_PEER_CREATE_CMDID:
+  if (sr7420_fw37_tlv(p, len, 0, WMI_TAG_PEER_CREATE_CMD, &fixed) ||
+      fixed != 20 || len != 32 || get_unaligned_le32(p + 4) >= 9 ||
+      sr7420_fw37_tlv(p, len, 20, WMI_TAG_ARRAY_STRUCT, &a) || a != 12 ||
+      sr7420_fw37_tlv(p, len, 24, WMI_TAG_MLO_PEER_CREATE_PARAMS, &a) ||
+      a != 8 || get_unaligned_le32(p + 28))
+   return -EINVAL;
+  /* Actual station MAC/type/flags are already wire compatible. */
+  return 0;
+ case WMI_MLO_READY_CMDID:
+  if (sr7420_fw37_tlv(p, len, 0, WMI_TAG_MLO_READY_CMD, &fixed) ||
+      fixed != 8 || len != 8)
+   return -EINVAL;
+  return 0;
+ default:
+  return 0;
+ }
+}
+
+static int sr7420_fw37_send(struct ath12k_wmi_pdev *wmi, struct sk_buff *skb,
+                          u32 cmd_id)
+{
+ struct ath12k_base *ab = wmi->wmi_ab->ab;
+ struct sr7420_stock32_state *st;
+ int domain, radio, ret;
+ u8 translated[384];
+ size_t translated_len;
+ u32 vdev = 0;
+ char name[32];
+
+ if (sr7420_stock_profile || !dev_is_pci(ab->dev))
+  return -EINVAL;
+ domain = pci_domain_nr(to_pci_dev(ab->dev)->bus);
+ if (domain < 0 || domain > 1)
+  return -ENODEV;
+ radio = domain == 0;
+ st = &sr7420_stock32_state[domain];
+ ret = sr7420_fw37_wire(cmd_id, radio, skb->data, skb->len,
+                       translated, sizeof(translated), &translated_len);
+ if (ret) {
+  ath12k_warn(ab, "SR7420_BRIDGE37_REJECT cmd=0x%x bytes=%u error=%d\n",
+              cmd_id, skb->len, ret);
+  return ret;
+ }
+ if (translated_len) {
+  ret = sr7420_stock32_replace(skb, translated, translated_len);
+  if (ret)
+   return ret;
+ }
+
+ if (cmd_id == WMI_INIT_CMDID) {
+  memset(st, 0, sizeof(*st));
+  ab->wow.wmi_conf_rx_decap_mode = ATH12K_HW_TXRX_ETHERNET;
+  ab->dp.peer_metadata_ver = ATH12K_PEER_METADATA_V1B;
+  ath12k_info(ab, "SR7420_SURVEY39_INIT enabled=%u advertised=%u flag1=0x%x\n",
+              sr7420_survey64,
+              test_bit(WMI_TLV_SERVICE_BSS_CHANNEL_INFO_64, ab->wmi_ab.svc_map),
+              sr7420_survey64 ? (unsigned int)WMI_RSRC_CFG_FLAG1_BSS_CHANNEL_INFO_64 : 0);
+  /* Keep host queries consistent with the negotiated resource flags. */
+  if (!sr7420_survey64)
+   clear_bit(WMI_TLV_SERVICE_BSS_CHANNEL_INFO_64, ab->wmi_ab.svc_map);
+ } else if (cmd_id == WMI_VDEV_CREATE_CMDID) {
+  if (skb->len < sizeof(struct wmi_vdev_create_cmd))
+   return -EINVAL;
+  vdev = get_unaligned_le32(skb->data + 4);
+  if (vdev >= ARRAY_SIZE(st->vdev_mac))
+   return -EOPNOTSUPP;
+  ether_addr_copy(st->vdev_mac[vdev], skb->data + 16);
+  clear_bit(vdev, &st->vdev_configured);
+  clear_bit(vdev, &st->vdev_up);
+ } else if (cmd_id == WMI_VDEV_DELETE_CMDID) {
+  if (skb->len < 8)
+   return -EINVAL;
+  vdev = get_unaligned_le32(skb->data + 4);
+  if (vdev < ARRAY_SIZE(st->vdev_mac)) {
+   eth_zero_addr(st->vdev_mac[vdev]);
+   clear_bit(vdev, &st->vdev_configured);
+   clear_bit(vdev, &st->vdev_up);
+  }
+ }
+ if (sr7420_stock_params) {
+  bool suppress = false;
+
+  if (cmd_id == WMI_MLO_SETUP_CMDID) {
+   ret = sr7420_stock32_pdev(wmi, radio, domain);
+   if (ret)
+    return ret;
+  }
+  if (cmd_id == WMI_PEER_CREATE_CMDID ||
+      cmd_id == WMI_VDEV_START_REQUEST_CMDID ||
+      cmd_id == WMI_VDEV_RESTART_REQUEST_CMDID) {
+   if (skb->len < 20)
+    return -EINVAL;
+   vdev = get_unaligned_le32(skb->data + 4);
+   if (vdev >= ARRAY_SIZE(st->vdev_mac))
+    return -EOPNOTSUPP;
+   /* Never turn an associated station into a self peer. */
+   if (cmd_id == WMI_VDEV_START_REQUEST_CMDID ||
+       cmd_id == WMI_VDEV_RESTART_REQUEST_CMDID ||
+       ether_addr_equal(st->vdev_mac[vdev], skb->data + 8)) {
+    ret = sr7420_stock32_vdev(wmi, radio, domain, vdev);
+    if (ret)
+     return ret;
+   }
+  }
+  switch (cmd_id) {
+  case WMI_VDEV_SET_PARAM_CMDID:
+  case 0x5019: case 0x5033: case 0x502d:
+   if (skb->len < 8)
+    return -EINVAL;
+   vdev = get_unaligned_le32(skb->data + 4);
+   suppress = vdev < ARRAY_SIZE(st->vdev_mac) &&
+              !test_bit(vdev, &st->vdev_up);
+   break;
+  case WMI_PDEV_SET_PARAM_CMDID:
+  case 0x4001: case 0x3a004: case 0x3e001: case 0x4021:
+  case 0x4029: case 0x1600f: case 0x1d017:
+   suppress = !st->vdev_up;
+   break;
+  }
+  if (suppress) {
+   ath12k_info(ab, "SR7420_BRIDGE37_BOOTSTRAP_SKIP cmd=0x%x bytes=%u\n",
+               cmd_id, skb->len);
+   dev_kfree_skb(skb);
+   return 0;
+  }
+ }
+ ath12k_info(ab, "SR7420_BRIDGE37_TX cmd=0x%x bytes=%u stock_params=%u\n",
+             cmd_id, skb->len, sr7420_stock_params);
+ if (sr7420_diag_payload &&
+     (cmd_id == WMI_INIT_CMDID || cmd_id == WMI_VDEV_CREATE_CMDID ||
+      cmd_id == WMI_VDEV_START_REQUEST_CMDID ||
+      cmd_id == WMI_VDEV_RESTART_REQUEST_CMDID ||
+      cmd_id == WMI_PEER_CREATE_CMDID || cmd_id == WMI_MLO_SETUP_CMDID ||
+      cmd_id == WMI_MLO_READY_CMDID)) {
+  snprintf(name, sizeof(name), "bridge37-%06x", cmd_id);
+  sr7420_diag_hex(ab, name, skb->data, skb->len);
+ }
+ if (cmd_id == WMI_VDEV_UP_CMDID || cmd_id == WMI_VDEV_DOWN_CMDID ||
+     cmd_id == WMI_VDEV_STOP_CMDID) {
+  if (skb->len < 8)
+   return -EINVAL;
+  vdev = get_unaligned_le32(skb->data + 4);
+ }
+ ret = sr7420_stock32_send_base(wmi, skb, cmd_id);
+ if (!ret && cmd_id == WMI_VDEV_UP_CMDID) {
+  if (vdev < ARRAY_SIZE(st->vdev_mac))
+   set_bit(vdev, &st->vdev_up);
+ }
+ if (!ret && (cmd_id == WMI_VDEV_DOWN_CMDID || cmd_id == WMI_VDEV_STOP_CMDID) &&
+     vdev < ARRAY_SIZE(st->vdev_mac))
+  clear_bit(vdev, &st->vdev_up);
+ return ret;
+}
+
+int ath12k_wmi_cmd_send(struct ath12k_wmi_pdev *wmi, struct sk_buff *skb, u32 cmd_id)
+{
+ struct ath12k_base *ab = wmi->wmi_ab->ab;
+ const u8 *data = NULL;
+ size_t len = 0;
+ u32 vdev = 0, freq = 0, center = 0;
+ u8 mac[8];
+ int domain, radio, ret;
+ if (sr7420_fw_bridge) return sr7420_fw37_send(wmi, skb, cmd_id);
+ if (!sr7420_stock_profile) return sr7420_stock32_send_base(wmi, skb, cmd_id);
+ if (!dev_is_pci(ab->dev)) return -ENODEV;
+ domain = pci_domain_nr(to_pci_dev(ab->dev)->bus);
+ if (domain < 0 || domain > 1) return -ENODEV;
+ radio = domain == 0; /* domain1=2.4GHz, domain0=5GHz, independently verified */
+ if (cmd_id == 1) {
+  if (skb->len < 64 || get_unaligned_le32(skb->data + 28) != 0 ||
+      get_unaligned_le32(skb->data + 36) != 9 ||
+      get_unaligned_le32(skb->data + 40) != 137) return -EINVAL;
+  memset(&sr7420_stock32_state[domain], 0, sizeof(sr7420_stock32_state[domain]));
+  ab->wow.wmi_conf_rx_decap_mode = ATH12K_HW_TXRX_ETHERNET;
+  ab->dp.peer_metadata_ver = 3;
+  data = sr7420_stock32_init; len = sizeof(sr7420_stock32_init);
+ } else if (cmd_id == 0x4003 || cmd_id == 0x5008 || cmd_id == 0x4001 ||
+            cmd_id == 0x5019 || cmd_id == 0x5033 || cmd_id == 0x502d ||
+            cmd_id == 0x3a004 || cmd_id == 0x3e001 || cmd_id == 0x4021 ||
+            cmd_id == 0x4029 || cmd_id == 0x1600f || cmd_id == 0x1d017) {
+  ath12k_info(ab, "SR7420_STOCK32_SUPPRESS native_cmd=0x%x bytes=%u\n", cmd_id, skb->len);
+  dev_kfree_skb(skb);
+  return 0;
+ } else if (cmd_id == 0x48002) {
+  ret = sr7420_stock32_pdev(wmi, radio, domain); if (ret) return ret;
+  if (radio) { data = sr7420_stock32_mlo1; len = sizeof(sr7420_stock32_mlo1); }
+  else { data = sr7420_stock32_mlo0; len = sizeof(sr7420_stock32_mlo0); }
+ } else if (cmd_id == 0x48003) {
+  data = sr7420_stock32_ready0; len = sizeof(sr7420_stock32_ready0);
+ } else if (cmd_id == 0x5001) {
+  if (skb->len < 48 || get_unaligned_le32(skb->data + 8) != 1) return -EINVAL;
+  vdev = get_unaligned_le32(skb->data + 4);
+  if (vdev >= 9) return -EINVAL;
+  memcpy(mac, skb->data + 16, sizeof(mac));
+  if (radio) { data = sr7420_stock32_create1; len = sizeof(sr7420_stock32_create1); }
+  else { data = sr7420_stock32_create0; len = sizeof(sr7420_stock32_create0); }
+ } else if (cmd_id == 0x6001) {
+  if (skb->len < 24) return -EINVAL;
+  vdev = get_unaligned_le32(skb->data + 4);
+  memcpy(mac, skb->data + 8, sizeof(mac));
+  ret = sr7420_stock32_vdev(wmi, radio, domain, vdev); if (ret) return ret;
+  if (radio) { data = sr7420_stock32_peer1; len = sizeof(sr7420_stock32_peer1); }
+  else { data = sr7420_stock32_peer0; len = sizeof(sr7420_stock32_peer0); }
+ } else if (cmd_id == 0x5003) {
+  unsigned int off = 0;
+  vdev = get_unaligned_le32(skb->data + 4);
+  while (off + 4 <= skb->len) {
+   u32 h = get_unaligned_le32(skb->data + off), n = (h & 0xffff) + 4;
+   if (n < 4 || off + n > skb->len) return -EINVAL;
+   if (h >> 16 == 80 && n >= 16) {
+    freq = get_unaligned_le32(skb->data + off + 4);
+    center = get_unaligned_le32(skb->data + off + 8);
+   }
+   off += n;
+  }
+  if (freq != (radio ? 5180 : 2412) || center != (radio ? 5210 : 2412)) {
+   ath12k_warn(ab, "SR7420_STOCK32_CHANNEL_MISMATCH freq=%u center=%u\n", freq, center);
+   return -EINVAL;
+  }
+  ret = sr7420_stock32_vdev(wmi, radio, domain, vdev); if (ret) return ret;
+  if (radio) { data = sr7420_stock32_start1; len = sizeof(sr7420_stock32_start1); }
+  else { data = sr7420_stock32_start0; len = sizeof(sr7420_stock32_start0); }
+ }
+ if (data) {
+  ret = sr7420_stock32_replace(skb, data, len); if (ret) return ret;
+  if (cmd_id == 0x5001 || cmd_id == 0x6001 || cmd_id == 0x5003)
+   put_unaligned_le32(vdev, skb->data + 4);
+  if (cmd_id == 0x5001) memcpy(skb->data + 16, mac, sizeof(mac));
+  if (cmd_id == 0x6001) memcpy(skb->data + 8, mac, sizeof(mac));
+ }
+ sr7420_stock32_trace(wmi, skb, cmd_id);
+ return sr7420_stock32_send_base(wmi, skb, cmd_id);
 }
 
