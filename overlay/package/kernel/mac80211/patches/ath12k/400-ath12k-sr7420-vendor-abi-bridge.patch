+/* Read the AP's actual HE Operation IE; he_oper.params is STA-populated. */
+static int ath12k_sr7420_ap_he_ops(struct ath12k_link_vif *arvif, u32 *ops)
+{
+	struct ieee80211_mutable_offsets offs = {};
+	const size_t ie_off = offsetof(struct ieee80211_mgmt, u.beacon.variable);
+	const struct element *elem;
+	struct sk_buff *bcn;
+	__le32 raw;
+	int ret = 0;
+
+	bcn = ieee80211_beacon_get_template(ath12k_ar_to_hw(arvif->ar),
+					    arvif->ahvif->vif, &offs, arvif->link_id);
+	if (!bcn)
+		return -ENOENT;
+	if (bcn->len < ie_off) {
+		ret = -EINVAL;
+		goto out;
+	}
+	elem = cfg80211_find_ext_elem(WLAN_EID_EXT_HE_OPERATION,
+				      bcn->data + ie_off, bcn->len - ie_off);
+	if (!elem || elem->datalen < 1 + sizeof(struct ieee80211_he_operation)) {
+		ret = -EINVAL;
+		goto out;
+	}
+	memcpy(&raw, elem->data + 1, sizeof(raw));
+	*ops = le32_to_cpu(raw);
+	ath12k_info(arvif->ar->ab,
+		    "SR7420_HE_BEACON vdev=%u bytes=%u he_ie_len=%u he_ops=0x%x\n",
+		    arvif->vdev_id, bcn->len, elem->datalen, *ops);
+out:
+	dev_kfree_skb(bcn);
+	return ret;
+}
