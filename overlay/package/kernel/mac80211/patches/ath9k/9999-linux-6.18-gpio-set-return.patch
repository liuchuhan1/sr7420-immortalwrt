Subject: [PATCH] ath9k: return success from the Linux 6.18 GPIO setter

--- a/drivers/net/wireless/ath/ath9k/gpio.c
+++ b/drivers/net/wireless/ath/ath9k/gpio.c
@@ -65,12 +65,20 @@
 }
 
 /* gpio_chip handler : set GPIO pin to value */
-static void ath9k_gpio_pin_set(struct gpio_chip *chip, unsigned offset,
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6,18,0)
+static int
+#else
+static void
+#endif
+ath9k_gpio_pin_set(struct gpio_chip *chip, unsigned offset,
 			       int value)
 {
 	struct ath_softc *sc = gpiochip_get_data(chip);
 
 	ath9k_hw_set_gpio(sc->sc_ah, offset, value);
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6,18,0)
+	return 0;
+#endif
 }
 
 /* register GPIO chip */
