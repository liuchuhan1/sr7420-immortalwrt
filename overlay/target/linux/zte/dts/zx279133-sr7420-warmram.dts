/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "zte/zx279133.dtsi"

/* Initial serial-console/RAM-root board, derived from SR7420 stock evidence. */
/ {
	model = "ZTE ZXSLC SR7420";
	compatible = "zte,zx279133-sr7420", "zte,zx279133";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x40000000>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-reset {
			label = "reset";
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <50>;
		};

		button-wps {
			label = "wps";
			gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
			debounce-interval = <50>;
		};
	};
};

/* Vendor OPP/voltage tables have not been validated on this board. */
&{/cpus/cpu@0} {
	/delete-property/ operating-points-v2;
	/delete-property/ cpu-supply;
};

&{/cpus/cpu@1} {
	/delete-property/ operating-points-v2;
	/delete-property/ cpu-supply;
};

&{/soc} {
	/delete-node/ regulator-cpu;
};

&uart0 {
	status = "okay";
};

/* Own map replaces the SR1010 partitions supplied by the common DTSI. */
&spifc {
	status = "okay";
	spi-max-frequency = <25000000>;

	flash@0 {
		spi-max-frequency = <25000000>;
		partitions-only;
		/delete-node/ partitions;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bootloader";
				reg = <0x00000000 0x00100000>;
				read-only;
			};

			partition@100000 {
				label = "tags";
				reg = <0x00100000 0x00100000>;
				read-only;
			};

			partition@200000 {
				label = "wifi";
				reg = <0x00200000 0x00200000>;
				read-only;
			};

			partition@400000 {
				label = "usercfg";
				reg = <0x00400000 0x00200000>;
				read-only;
			};

			partition@600000 {
				label = "defcfg";
				reg = <0x00600000 0x00200000>;
				read-only;
			};

			partition@800000 {
				label = "firmware-slot1";
				reg = <0x00800000 0x05000000>;
				read-only;
			};

			partition@5800000 {
				label = "firmware-slot2";
				reg = <0x05800000 0x05000000>;
				read-only;
			};

			partition@b500000 {
				label = "DPIPlugin";
				reg = <0x0b500000 0x00300000>;
				read-only;
			};

			partition@ba00000 {
				label = "status";
				reg = <0x0ba00000 0x00500000>;
				read-only;
			};

			partition@c000000 {
				label = "Plugin";
				reg = <0x0c000000 0x04000000>;
				read-only;
			};
		};
	};
};

/* RAM diagnostic resource draft; NPPT remains disabled. */
/ {
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		stock-low@aa400000 {
			reg = <0 0xaa400000 0 0x1600000>;
			no-map;
		};
		sr7420_idm: idm@aba00000 {
			reg = <0 0xaba00000 0 0xa00000>;
			no-map;
		};
		sr7420_se_hash: se-hash@ac400000 {
			reg = <0 0xac400000 0 0x8000000>;
			no-map;
		};
		sr7420_bmu: bmu-dma@b4400000 {
			reg = <0 0xb4400000 0 0xecc000>;
			no-map;
		};
		bmu-spare@b52cc000 {
			reg = <0 0xb52cc000 0 0x24000>;
			no-map;
		};
		ramlog@b52f0000 {
			reg = <0 0xb52f0000 0 0x10000>;
			no-map;
		};
		stock-wifi-woe@b5300000 {
			reg = <0 0xb5300000 0 0xad00000>;
			no-map;
		};
	};
};

&nppt {
	zte,lan-only;
	memory-region = <&sr7420_bmu>, <&sr7420_se_hash>, <&sr7420_idm>;
	memory-region-names = "bmu", "se-hash", "idm";
	status = "disabled";
};

&nppt {
 status = "okay";
 local-mac-address = [02 74 20 00 00 01];
 lan_cpu_diag: ethernet-lan-cpu {
  compatible = "zte,zx279133-lan-conduit";
 };
 switch {
  compatible = "zte,zx279133-rtl8372n";
  zte,mdio-handle = <&sr7420_smi>;
  zte,sr7420-warm-switch;
  ports {
   #address-cells = <1>;
   #size-cells = <0>;
   port@4 { reg = <4>; label = "lan1"; phy-mode = "internal"; };
   port@5 { reg = <5>; label = "lan2"; phy-mode = "internal"; };
   port@6 { reg = <6>; label = "lan3"; phy-mode = "internal"; };
   port@7 { reg = <7>; label = "lan4"; phy-mode = "internal"; };
   port@8 {
    reg = <8>;
    ethernet = <&lan_cpu_diag>;
    phy-mode = "10gbase-r";
    fixed-link { speed = <10000>; full-duplex; };
   };
  };
 };
};
&mdio1 {
 status = "okay";
 sr7420_smi: switch-controller@1d {
  compatible = "realtek,rtl8372n";
  reg = <0x1d>;
 };
};
&uni_serdes { status = "okay"; };
&xpcs0 { status = "okay"; };
&watchdog1 { status = "okay"; };
&{/chosen} { sr7420-ramlog-attempt = "wifi-20261116-05"; };

/* SR1010 CPU PWM pinmux conflicts with the verified SR7420 WPS GPIO. */
&pwm { status = "disabled"; };

/* RAM-only USB root-hub probe; no automount. */
&usb3 { status = "okay"; };

#include "zte/zx279133-sr7420-ledboard.dtsi"

/* RAM-only: require the OEM to have brought up both links. */
/ {
 soc {
  sr7420_pcie0: pcie@15200000 {
   compatible = "zte,zx279133-pcie-warm-ramdiag";
   device_type = "pci";
   #address-cells = <3>;
   #size-cells = <2>;
   #interrupt-cells = <1>;
   reg = <0 0x15200000 0 0x2000>, <0 0x1f000000 0 0x400000>,
         <0 0x2f800000 0 0x1000>;
   reg-names = "csr", "dbi", "config";
   linux,pci-domain = <0>;
   bus-range = <0 1>;
   ranges = <0x02000000 0 0x20000000 0 0x20000000 0 0xf000000>;
   dma-ranges = <0x42000000 0 0x80000000 0 0x80000000 0 0x40000000>;
   dma-coherent;
   interrupt-parent = <&gic>;
   msi-controller;
   #msi-cells = <0>;
   msi-parent = <&sr7420_pcie0>;
   interrupt-map-mask = <0 0 0 7>;
   interrupt-map = <0 0 0 1 &gic 0 0 0 113 4>,
                   <0 0 0 2 &gic 0 0 0 112 4>,
                   <0 0 0 3 &gic 0 0 0 111 4>,
                   <0 0 0 4 &gic 0 0 0 110 4>;
   zte,msi-spi-base = <67>;
   zte,msi-message-address = <0 0x10e00000>;
   status = "okay";
   pcie0_rp@0 {
    reg = <0 0 0 0 0>;
    #address-cells = <3>;
    #size-cells = <2>;
    radio@0 {
     reg = <0 0 0 0 0>;
     qcom,ath12k-calibration-variant = "zte-sr7420-5g";
    };
   };
  };
  sr7420_pcie1: pcie@15202000 {
   compatible = "zte,zx279133-pcie-warm-ramdiag";
   device_type = "pci";
   #address-cells = <3>;
   #size-cells = <2>;
   #interrupt-cells = <1>;
   reg = <0 0x15202000 0 0x2000>, <0 0x1f400000 0 0x400000>,
         <0 0x3f800000 0 0x1000>;
   reg-names = "csr", "dbi", "config";
   linux,pci-domain = <1>;
   bus-range = <0 1>;
   ranges = <0x02000000 0 0x30000000 0 0x30000000 0 0xf000000>;
   dma-ranges = <0x42000000 0 0x80000000 0 0x80000000 0 0x40000000>;
   dma-coherent;
   interrupt-parent = <&gic>;
   msi-controller;
   #msi-cells = <0>;
   msi-parent = <&sr7420_pcie1>;
   interrupt-map-mask = <0 0 0 7>;
   interrupt-map = <0 0 0 1 &gic 0 0 0 164 4>,
                   <0 0 0 2 &gic 0 0 0 163 4>,
                   <0 0 0 3 &gic 0 0 0 162 4>,
                   <0 0 0 4 &gic 0 0 0 161 4>;
   zte,msi-spi-base = <118>;
   zte,msi-message-address = <0 0x10e00004>;
   status = "okay";
   pcie1_rp@0 {
    reg = <0 0 0 0 0>;
    #address-cells = <3>;
    #size-cells = <2>;
    radio@0 {
     reg = <0 0 0 0 0>;
     qcom,ath12k-calibration-variant = "zte-sr7420-2g";
    };
   };
  };
 };
};


/* Preserve the validated 128 MiB CMA window below stock reserved memory. */
&{/reserved-memory} {
 linux,cma {
  compatible = "shared-dma-pool";
  reusable;
  size = <0 0x08000000>;
  alignment = <0 0x00400000>;
  alloc-ranges = <0 0x80000000 0 0x2a400000>;
  linux,cma-default;
 };
};
