/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "zte/zx279133.dtsi"

/* Initial serial-console/RAM-root board, derived from SR7420 stock evidence. */
/ {
	model = "ZTE ZXSLC SR7420";
	compatible = "zte,zx279133-sr7420", "zte,zx279133";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x40000000>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-reset {
			label = "reset";
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <50>;
		};

		button-wps {
			label = "wps";
			gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
			debounce-interval = <50>;
		};
	};
};

/* Vendor OPP/voltage tables have not been validated on this board. */
&{/cpus/cpu@0} {
	/delete-property/ operating-points-v2;
	/delete-property/ cpu-supply;
};

&{/cpus/cpu@1} {
	/delete-property/ operating-points-v2;
	/delete-property/ cpu-supply;
};

&{/soc} {
	/delete-node/ regulator-cpu;
};

&uart0 {
	status = "okay";
};

/* Own map replaces the SR1010 partitions supplied by the common DTSI. */
&spifc {
	status = "okay";
	spi-max-frequency = <25000000>;

	flash@0 {
		spi-max-frequency = <25000000>;
		partitions-only;
		/delete-node/ partitions;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bootloader";
				reg = <0x00000000 0x00100000>;
				read-only;
			};

			partition@100000 {
				label = "tags";
				reg = <0x00100000 0x00100000>;
				read-only;
			};

			partition@200000 {
				label = "wifi";
				reg = <0x00200000 0x00200000>;
				read-only;
			};

			partition@400000 {
				label = "usercfg";
				reg = <0x00400000 0x00200000>;
				read-only;
			};

			partition@600000 {
				label = "defcfg";
				reg = <0x00600000 0x00200000>;
				read-only;
			};

			partition@800000 {
				label = "firmware-slot1";
				reg = <0x00800000 0x05000000>;
				read-only;
			};

			partition@5800000 {
				label = "firmware-slot2";
				reg = <0x05800000 0x05000000>;
				read-only;
			};

			partition@b500000 {
				label = "DPIPlugin";
				reg = <0x0b500000 0x00300000>;
				read-only;
			};

			partition@ba00000 {
				label = "status";
				reg = <0x0ba00000 0x00500000>;
				read-only;
			};

			partition@c000000 {
				label = "Plugin";
				reg = <0x0c000000 0x04000000>;
				read-only;
			};
		};
	};
};

/* SR1010 CPU PWM pinmux conflicts with the SR7420 WPS GPIO. */
&pwm {
	status = "disabled";
};
