+/* Software-only diagnostics also work when the WAN XMAC is disabled. */
+static void
+zx279133_lan_get_rx_diagnostics(struct zx279133_lan_service *service, u64 *data)
+{
+ struct zx279133_eth *eth = zx279133_lan_service_to_eth(service);
+ unsigned int group, start, i;
+
+ memset(data, 0, sizeof(u64) * ZX279133_LAN_DIAG_COUNT);
+ for (group = 0; group < 2; group++) {
+  struct zx279133_rx_stats *stats = &eth->rx_stats[group];
+  u64 sample[ZX279133_LAN_DIAG_COUNT];
+
+  do {
+   start = u64_stats_fetch_begin(&stats->syncp);
+#define ZX279133_LAN_RX_DIAG_READ(name) \
+   sample[ZX279133_LAN_DIAG_##name] = u64_stats_read(&stats->name);
+   ZX279133_LAN_RX_DIAG_FIELDS(ZX279133_LAN_RX_DIAG_READ)
+#undef ZX279133_LAN_RX_DIAG_READ
+  } while (u64_stats_fetch_retry(&stats->syncp, start));
+  for (i = 0; i < ZX279133_LAN_DIAG_COUNT; i++)
+   data[i] += sample[i];
+ }
+}
