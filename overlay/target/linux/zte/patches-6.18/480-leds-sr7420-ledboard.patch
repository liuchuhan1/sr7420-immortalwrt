+++ b/drivers/leds/rgb/Kconfig
@@ -75,4 +75,14 @@
 	  This driver can also be built as a module. If so, the module
 	  will be called "leds-mt6370-rgb".
 
+config LEDS_SR7420_LEDBOARD
+	tristate "SR7420 RGB effect board"
+	depends on I2C && OF
+	help
+	  Support the I2C RGB effect board in the ZTE SR7420. Provides
+	  multicolor LED brightness/intensity and volatile hardware effects.
+	  No persistent-save command is exposed.
+
+	  The module will be called leds-sr7420-ledboard.
+
 endif # LEDS_CLASS_MULTICOLOR
