CONFIG_TARGET_zte=y
CONFIG_TARGET_zte_zx279133=y
CONFIG_TARGET_zte_zx279133_DEVICE_zte_zxslc-sr7420=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_ALL_KMODS=y
CONFIG_SIGNED_PACKAGES=y
CONFIG_USE_APK=y
CONFIG_DOWNLOAD_CHECK_CERTIFICATE=y
CONFIG_REPRODUCIBLE_DEBUG_INFO=y
CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_KERNEL_BUILD_DOMAIN="sr7420"
CONFIG_PACKAGE_kmod-zte-sr7420-pcie=y
CONFIG_PACKAGE_kmod-leds-sr7420-ledboard=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-ath12k=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-basic-openssl is not set
# CONFIG_PACKAGE_ath12k-firmware-qcn9274 is not set

CONFIG_PACKAGE_kmod-i2c-core=y
CONFIG_PACKAGE_kmod-i2c-gpio=y
CONFIG_PACKAGE_kmod-i2c-algo-bit=y
CONFIG_PACKAGE_kmod-leds-class-multicolor=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_sfdisk=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_kexec=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
